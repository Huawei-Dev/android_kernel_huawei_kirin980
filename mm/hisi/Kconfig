menuconfig HISI_MM
	bool "Hisilicon MM support"
	---help---
	  This option add some hisilicon mm codes, needed by following modules.

if HISI_MM

config HISI_SLOW_PATH_COUNT
	bool "page alloc enter slow path count"
	default n
	help
	  Say 'Y' here is you want to count page alloc slow path.

endif

config HISI_PMALLOC
	bool "Protectable Memory Allocator"
	default y
	depends on MMU
	depends on HISI_MM
	select  GENERIC_ALLOCATOR
	help
	It allows to write-protect variables allocated dynamically
	ls /sys/kernel/pmalloc

config DEBUG_HISI_PMALLOC
	bool "Tests for Protectable Memory Allocator"
	default y
	depends on HISI_PMALLOC && HISI_HHEE_DEBUG
	help
	Various entries are listed under /sys/kernel/debug/pmalloc

config HISI_QOS_MEM_OPT
	bool "Qos memory alloc opt"
	default n
	depends on HW_QOS_THREAD || HW_VIP_THREAD
	help
	  key process memory alloc opt

config HUAWEI_UNMOVABLE_ISOLATE
	bool "Isolate the unmovable memory."
	depends on ARM64
	default n
	  help
	  Isolate the unmovable memory from others migrate types.
	  So that we can improve the success rate of compact.

	  If unsure, say "n".

config HUAWEI_UNMOVABLE_ISOLATE1_SIZE_MBYTES
	int "Size in Mega Bytes For UNMOVABLE_ISOLATE1"
	depends on HUAWEI_UNMOVABLE_ISOLATE
	default 64
	help
	  Defines the size (in MiB) of the default memory area for
	  MIGRATE_UNMOVABLE_ISOLATE1 Memory Allocator. However,
	  we should parse the size from /proc/cmdline firstly.

config HUAWEI_UNMOVABLE_ISOLATE2_SIZE_MBYTES
	int "Size in Mega Bytes For UNMOVABLE_ISOLATE2"
	depends on HUAWEI_UNMOVABLE_ISOLATE
	default 64
	help
	  Defines the size (in MiB) of the default memory area for
	  MIGRATE_UNMOVABLE_ISOLATE2 Memory Allocator. However,
	  we should parse the size from /proc/cmdline firstly.

config HISI_PAGECACHE_HELPER
	tristate "KIRIN page cache helper module"
	default n

	---help---
	This selects the Kirin page cache helper module.

	Select this if you want to optimize your Android system.
	If unsure, say N.

config HISI_PAGECACHE_DEBUG
	tristate "KIRIN page cache trace module"
	default n
	depends on HISI_DEBUG_FS

	---help---
	This selects the Kirin page cache trace module.

	Select this if you want to optimize your Android system.
	If unsure, say N.
