				compatible = "hisilicon,hi6405-codec";
				hisilicon,mic_num = <0x4>;
				hisilicon,coefficient = <0xa8c>;
				hisilicon,hs_3_pole_min_voltage = <0x0>;
				hisilicon,hs_3_pole_max_voltage = <0x8>;
				hisilicon,hs_4_pole_min_voltage = <0x47e>;
				hisilicon,hs_4_pole_max_voltage = <0xa5a>;
