	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x1>;
		interrupts = <0x1 0xd 0xff08 0x1 0xe 0xff08 0x1 0xb 0xff08 0x1 0xa 0xff08>;
		clock-frequency = <0x1d4c00>;
		arm,no-tick-in-suspend;
	};

	prktimer@fff0a000 {
		compatible = "hisilicon,prktimer";
		fpga_flag = <0x0>;
		reg = <0x0 0xfff0a000 0x0 0x1000>;
		status = "disabled";
		phandle = <0x487>;
	};

	timer@fff14000 {
		compatible = "arm,sp804", "arm,primecell";
		reg = <0x0 0xfff14000 0x0 0x1000>;
		interrupts = <0x0 0x30 0x4 0x0 0x31 0x4>;
		clocks = <0x11a 0x11a 0x23>;
		clock-names = "osc32khz", "osc32khz", "apb_pclk";
		status = "ok";
		phandle = <0x488>;
	};

	interrupt-controller@ea000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x3>;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;
		interrupt-controller;
		redistributor-stride = <0x0 0x20000>;
		redistributor-region = <0x1>;
		reg = <0x0 0xea000000 0x0 0x10000 0x0 0xea040000 0x0 0x100000>;
		interrupts = <0x1 0x9 0x4>;
		phandle = <0x1>;
	};

	clocks@0 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x0 0x0 0xffffffff>;

		clkin_sys {
			compatible = "fixed-clock";
